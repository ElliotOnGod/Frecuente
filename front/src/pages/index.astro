---
/** Inicio — Hero + catálogo por categoría (isla) + contexto + ubicación del local. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContextSection from "../components/ContextSection.astro";
import Ubicacion from "../components/Ubicacion.astro";
import CatalogoHome from "../components/islas/CatalogoHome.jsx";
---
<BaseLayout>
  <div class="cf-contenedor">
    <Hero />

    <!-- client:load: se pinta el skeleton en el HTML y se hidrata al cargar -->
    <CatalogoHome client:load>
      <ContextSection />
    </CatalogoHome>

    <!-- Tarjeta estática + mapa (isla con client:visible) -->
    <Ubicacion />
  </div>
</BaseLayout>
