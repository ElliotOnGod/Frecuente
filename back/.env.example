# Copia este archivo a .env si tu MongoDB no está en la dirección por defecto.
# Local:          mongodb://localhost:27017
# MongoDB Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB=frecuente

# Clave para firmar las sesiones (tokens JWT) y los códigos de canje.
# Pon cualquier texto largo y secreto; si la cambias, todas las sesiones
# abiertas se cierran. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacía (o con este valor de ejemplo) el backend crea una
# temporal en cada arranque: funciona, pero te saca de la sesión al reiniciar.
JWT_SECRET=cambia-esta-clave-en-produccion

# ---------------- Pagos ----------------
# simulado  → pasarela de prueba local, no necesita cuentas (por defecto)
# sandbox   → entornos de PRUEBA reales de Mercado Pago y PayPal (no cobra de verdad)
PAGOS_MODO=simulado

# A dónde regresan Mercado Pago y PayPal después de pagar (el front de Astro)
FRONT_URL=http://localhost:4321

# Mercado Pago: Tus integraciones → Credenciales de prueba → Access Token
# (empieza con TEST- o APP_USR- de un usuario de prueba)
MP_ACCESS_TOKEN=
# Correo del comprador de prueba (Tus integraciones → Cuentas de prueba →
# Comprador). Recomendado: Mercado Pago pide que en pruebas pague una cuenta
# de prueba; con el correo real del cliente las tarjetas de prueba fallan.
MP_COMPRADOR_PRUEBA=
# Opcional: URL pública del backend (ngrok) para recibir webhooks y su clave secreta
BACKEND_PUBLIC_URL=
MP_WEBHOOK_SECRET=

# PayPal: developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com

# Datos que ve el cliente al pagar por transferencia o en efectivo
TRANSFERENCIA_BANCO=BBVA México
TRANSFERENCIA_CLABE=012 320 00123456789 0
TRANSFERENCIA_TITULAR=Café Frecuente (cuenta de prueba)
TIENDA_DIRECCION=Café Frecuente, Guadalajara, Jalisco (horario del local)
