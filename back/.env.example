# Copia este archivo a .env y llena lo que necesites.
# En Render estas mismas variables van en Environment (nunca en el código).

# ---------------- Bases de datos ----------------
# MongoDB: catálogo, fotos, planes y membresías
# Local:          mongodb://localhost:27017
# MongoDB Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB=frecuente

# PostgreSQL: usuarios, pedidos, pagos, envíos, recompras y correos
# Neon: Dashboard → Connect → copia la "Connection string" (trae ?sslmode=require)
#   postgresql://USUARIO:CONTRASEÑA@ep-xxxx.us-east-2.aws.neon.tech/frecuente?sslmode=require
# Local: postgresql://postgres:postgres@localhost:5432/frecuente
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frecuente

# Zona horaria del servidor (el "día" del código de membresía y las recompras).
# Render corre en UTC; en Render pon TZ=America/Mexico_City
TZ=America/Mexico_City

# Clave para firmar las sesiones (tokens JWT) y los códigos de canje.
# Pon cualquier texto largo y secreto; si la cambias, todas las sesiones
# abiertas se cierran. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacía (o con este valor de ejemplo) el backend crea una
# temporal en cada arranque: funciona, pero te saca de la sesión al reiniciar.
JWT_SECRET=cambia-esta-clave-en-produccion

# ---------------- Pagos ----------------
# simulado  → pasarela de prueba local, no necesita cuentas (por defecto)
# sandbox   → entornos de PRUEBA reales de Mercado Pago y PayPal (no cobra de verdad)
PAGOS_MODO=simulado

# A dónde regresan Mercado Pago y PayPal después de pagar (el front de Astro)
FRONT_URL=http://localhost:4321

# Mercado Pago: Tus integraciones → Credenciales de prueba → Access Token
# (empieza con TEST- o APP_USR- de un usuario de prueba)
MP_ACCESS_TOKEN=
# Correo del comprador de prueba (Tus integraciones → Cuentas de prueba →
# Comprador). Recomendado: Mercado Pago pide que en pruebas pague una cuenta
# de prueba; con el correo real del cliente las tarjetas de prueba fallan.
MP_COMPRADOR_PRUEBA=
# Opcional: URL pública del backend (ngrok) para recibir webhooks y su clave secreta
BACKEND_PUBLIC_URL=
MP_WEBHOOK_SECRET=

# PayPal: developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com

# Datos que ve el cliente al pagar por transferencia o en efectivo
TRANSFERENCIA_BANCO=BBVA México
TRANSFERENCIA_CLABE=012 320 00123456789 0
TRANSFERENCIA_TITULAR=Café Frecuente (cuenta de prueba)
TIENDA_DIRECCION=Café Frecuente, Guadalajara, Jalisco (horario del local)

# ---------------- Envíos: Envia.com ----------------
# Sin token → modo simulado (precios calculados aquí y guías SIM…).
# Con token → entorno de pruebas real: envia.com → Desarrolladores → API Token (Test)
ENVIA_TOKEN=
ENVIA_API=https://api-test.envia.com
ENVIA_PAQUETERIAS=estafeta,fedex,dhl
TIENDA_TELEFONO=3300000000

# ---------------- Correos: Brevo ----------------
# Sin llave → modo simulado (se anotan en la bitácora y en la consola).
# Brevo → SMTP & API → API Keys. El remitente debe estar verificado en
# Brevo → Senders (basta con un correo tuyo, no hace falta dominio).
BREVO_API_KEY=
BREVO_REMITENTE=
BREVO_REMITENTE_NOMBRE=Frecuente Café
# A dónde llega el aviso de "pedido nuevo" de la tienda
CORREO_TIENDA=

# ---------------- Producción ----------------
# Orígenes que pueden usar la API desde el navegador (separados por coma).
# Vacío = cualquiera (desarrollo). En Render: https://TU-SITIO.netlify.app
CORS_ORIGENES=
# Recompras: el backend revisa cada hora si toca generar pedidos.
RECOMPRAS_AUTOMATICAS=1
RECOMPRAS_CADA_MINUTOS=60
# Clave para POST /tareas/recompras (cron externo). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
